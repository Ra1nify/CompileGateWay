{
  "displayName": "Kotlin Multiplatform for iOS",
  "platform": "kotlin-multiplatform-ios",
  "include": {
    "paths": [
      "gradlew",
      "settings.gradle.kts",
      "composeApp/build.gradle.kts",
      "iosApp/*.xcodeproj",
      "composeApp/src/iosMain"
    ]
  },
  "variables": [
    { "name": "scheme", "label": "Xcode Scheme", "required": false, "default": "iosApp" },
    { "name": "configuration", "label": "Build Configuration", "required": false, "default": "Release" },
    { "name": "sdk", "label": "SDK", "required": false, "default": "iphoneos" },
    { "name": "destination", "label": "Destination", "required": false, "default": "generic/platform=iOS" },
    { "name": "rustTarget", "label": "Rust Target Triple", "required": false, "default": "aarch64-apple-ios" },
    { "name": "gradleTask", "label": "Gradle Framework Task", "required": false, "default": "embedAndSignAppleFrameworkForXcode" }
  ],
  "build": {
    "steps": [
      "chmod +x gradlew",
      "if [ -f rust/Cargo.toml ]; then cargo build --release --target {{rustTarget}} --manifest-path rust/Cargo.toml; fi",
      "./gradlew {{gradleTask}}",
      "xcodebuild -project iosApp/iosApp.xcodeproj -scheme {{scheme}} -configuration {{configuration}} -sdk {{sdk}} -destination {{destination}} -derivedDataPath .cgw/derived-data {{signingExtraArgs}} build"
    ],
    "artifactPath": ".cgw/derived-data/Build/Products/{{configuration}}-{{sdk}}/{{scheme}}.app",
    "artifacts": [
      ".cgw/derived-data/Build/Products/{{configuration}}-{{sdk}}/{{scheme}}.app",
      ".cgw/derived-data/Build/Products/{{configuration}}-{{sdk}}/{{scheme}}.app.dSYM"
    ]
  },
  "cache": {
    "paths": [".gradle/", "build/", "*/build/", "iosApp/build/", ".cgw/"]
  }
}
